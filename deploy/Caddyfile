{$DOMAIN} {
	# /healthz публичный: статус деплоя без данных. Всё остальное под паролем.
	@protected not path /healthz
	basic_auth @protected {
		{$AUTH_USER} {$AUTH_HASH}
	}
	# /api и /api/... → бэкенд (фронт шлёт /api/?resource=..., но /api?resource=... тоже ловим)
	handle /api* {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}
	handle /healthz {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:80
	}
	handle_errors 502 503 504 {
		@health path /healthz
		respond @health `{"status":"down","backend":"down"}` 503
	}
}
